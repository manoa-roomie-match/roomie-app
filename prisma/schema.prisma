generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role   @default(USER)
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}

model Student {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  firstName       String
  lastName        String
  hobbies         String
  bioInfo         String
  cleanliness     Ratings
  noiseLevels     Ratings
  major           String
  profilePicture  String    @default("https://img.icons8.com/?size=100&id=7820&format=png")
}

enum Ratings {
  ONE
  TWO
  THREE
  FOUR
  FIVE
}

enum Role {
  USER
  ADMIN
}

enum Condition {
  excellent
  good
  fair
  poor
}
