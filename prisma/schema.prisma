generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role   @default(USER)
  sentMessages     Message[] @relation("sentMessages")
  receivedMessages Message[] @relation("receivedMessages")
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}

model Student {
  id             Int     @id @default(autoincrement())
  email          String  @unique
  firstName      String
  lastName       String
  hobbies        String
  bioInfo        String
  cleanliness    Ratings
  noiseLevels    Ratings
  major          String
  profilePicture String  @default("https://img.icons8.com/?size=100&id=7820&format=png")
}

enum Ratings {
  ONE
  TWO
  THREE
  FOUR
  FIVE
}

enum Role {
  USER
  ADMIN
}

enum Condition {
  excellent
  good
  fair
  poor
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  content    String
  createdAt  DateTime @default(now())
  readAt     DateTime?

  sender   User @relation("sentMessages", fields: [senderId], references: [id])
  receiver User @relation("receivedMessages", fields: [receiverId], references: [id])
}
